{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ReverseProxy": {
    "Routes": {
      "userRoute": {
        "ClusterId": "userCluster",
        "Match": {
          "Path": "/api/userprofiles/{**catch-all}"
        },
        "Metadata": {
          "RateLimitPolicy": "ProfileUpdatesPerHour"
        }
      },
      "botRoute": {
        "ClusterId": "userCluster",
        "Match": {
          "Path": "/api/bot/{**catch-all}"
        }
      },
      "profileRoute": {
        "ClusterId": "userCluster",
        "Match": {
          "Path": "/profile/{**catch-all}"
        },
        "Metadata": {
          "RateLimitPolicy": "ProfileViewsPerMinute"
        }
      },
      "wizardRoute": {
        "ClusterId": "userCluster",
        "Match": {
          "Path": "/api/wizard/{**catch-all}"
        },
        "Metadata": {
          "RateLimitPolicy": "ProfileUpdatesPerHour"
        }
      },
      "profilesRoute": {
        "ClusterId": "userCluster",
        "Match": {
          "Path": "/api/profiles/{**catch-all}"
        },
        "Metadata": {
          "RateLimitPolicy": "ProfileUpdatesPerHour"
        }
      },
      "supportRoute": {
        "ClusterId": "userCluster",
        "Match": {
          "Path": "/api/support/{**catch-all}"
        },
        "Metadata": {
          "RateLimitPolicy": "ProfileUpdatesPerHour"
        }
      },
      "billingRoute": {
        "ClusterId": "userCluster",
        "Match": {
          "Path": "/api/billing/{**catch-all}"
        },
        "Metadata": {
          "RateLimitPolicy": "ProfileViewsPerMinute",
          "BypassAuthentication": "true"
        }
      },
      "matchmakingRoute": {
        "ClusterId": "matchmakingCluster",
        "Match": {
          "Path": "/api/matchmaking/{**catch-all}"
        },
        "Metadata": {
          "RateLimitPolicy": "MatchActionsPerMinute"
        }
      },
      "compatibilityRoute": {
        "ClusterId": "matchmakingCluster",
        "Match": {
          "Path": "/api/compatibility/{**catch-all}"
        },
        "Metadata": {
          "RateLimitPolicy": "MatchActionsPerMinute"
        }
      },
      "swipeRoute": {
        "ClusterId": "swipeCluster",
        "Match": {
          "Path": "/api/swipes/{**catch-all}"
        },
        "Metadata": {
          "RateLimitPolicy": "SwipesPerMinute"
        }
      },
      "photoRoute": {
        "ClusterId": "photoCluster",
        "Match": {
          "Path": "/api/photos/{**catch-all}"
        },
        "Metadata": {
          "RateLimitPolicy": "PhotoUploadsPerDay"
        }
      },
      "messagingRoute": {
        "ClusterId": "messagingCluster",
        "Match": {
          "Path": "/api/messages/{**catch-all}"
        },
        "Metadata": {
          "RateLimitPolicy": "MessagesPerMinute"
        }
      },
      "messagingHubRoute": {
        "ClusterId": "messagingCluster",
        "Match": {
          "Path": "/hubs/messages/{**catch-all}"
        },
        "Metadata": {
          "Transport": "websocket"
        }
      },
      "messagingHubLegacyRoute": {
        "ClusterId": "messagingCluster",
        "Match": {
          "Path": "/messagingHub/{**catch-all}"
        },
        "Metadata": {
          "Transport": "websocket"
        }
      },
      "matchmakingHubRoute": {
        "ClusterId": "matchmakingCluster",
        "Match": {
          "Path": "/hubs/matchmaking/{**catch-all}"
        },
        "Metadata": {
          "Transport": "websocket"
        }
      },
      "safetyRoute": {
        "ClusterId": "safetyCluster",
        "Match": {
          "Path": "/api/safety/{**catch-all}"
        },
        "Metadata": {
          "RateLimitPolicy": "SafetyReportsDaily"
        }
      },
      "psykologRoute": {
        "ClusterId": "userCluster",
        "Match": {
          "Path": "/api/psykolog/{**catch-all}"
        }
      },
      "healthRoute": {
        "ClusterId": "healthCluster",
        "Match": {
          "Path": "/health/{**catch-all}"
        }
      },
      "notificationsRoute": {
        "ClusterId": "userCluster",
        "Match": {
          "Path": "/api/notifications/{**catch-all}"
        }
      },
      "testerRoute": {
        "ClusterId": "testerCluster",
        "Match": {
          "Path": "/api/tester/{**catch-all}"
        }
      },
      "forumRoute": {
        "ClusterId": "forumCluster",
        "Match": {
          "Path": "/api/forum/{**catch-all}"
        }
      },
      "reputationRoute": {
        "ClusterId": "reputationCluster",
        "Match": {
          "Path": "/api/reputation/{**catch-all}"
        }
      },
      "videoRoute": {
        "ClusterId": "videoCluster",
        "Match": {
          "Path": "/api/videos/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "userCluster": {
        "Destinations": {
          "userService": {
            "Address": "http://localhost:8082/"
          }
        }
      },
      "matchmakingCluster": {
        "Destinations": {
          "matchmakingService": {
            "Address": "http://localhost:8083/"
          }
        }
      },
      "photoCluster": {
        "Destinations": {
          "photoService": {
            "Address": "http://localhost:8085/"
          }
        }
      },
      "messagingCluster": {
        "Destinations": {
          "messagingService": {
            "Address": "http://localhost:8086/"
          }
        }
      },
      "swipeCluster": {
        "Destinations": {
          "swipeService": {
            "Address": "http://localhost:8087/"
          }
        }
      },
      "safetyCluster": {
        "Destinations": {
          "safetyService": {
            "Address": "http://localhost:8088/"
          }
        }
      },
      "healthCluster": {
        "LoadBalancingPolicy": "RoundRobin",
        "Destinations": {
          "userService": {
            "Address": "http://localhost:8082/"
          },
          "matchmakingService": {
            "Address": "http://localhost:8083/"
          },
          "photoService": {
            "Address": "http://localhost:8085/"
          },
          "messagingService": {
            "Address": "http://localhost:8086/"
          },
          "swipeService": {
            "Address": "http://localhost:8087/"
          },
          "safetyService": {
            "Address": "http://localhost:8088/"
          }
        }
      },
      "testerCluster": {
        "Destinations": {
          "testerService": {
            "Address": "http://localhost:8093/"
          }
        }
      },
      "forumCluster": {
        "Destinations": {
          "forumService": {
            "Address": "http://localhost:8092/"
          }
        },
        "HttpRequest": {
          "ActivityTimeout": "00:05:00"
        }
      },
      "reputationCluster": {
        "Destinations": {
          "reputationService": {
            "Address": "http://localhost:8091/"
          }
        }
      },
      "videoCluster": {
        "Destinations": {
          "videoService": {
            "Address": "http://localhost:8094/"
          }
        }
      }
    }
  },
  "Authentication": {
    "Keycloak": {
      "Authority": "http://localhost:8090/realms/DatingApp",
      "Audience": "yarp-gateway",
      "Audiences": [
        "yarp-gateway",
        "matchmaking-service",
        "photo-service",
        "messaging-service",
        "swipe-service",
        "safety-service"
      ],
      "RequireHttpsMetadata": false,
      "ValidIssuers": [
        "http://localhost:8090/realms/DatingApp",
        "http://127.0.0.1:8090/realms/DatingApp",
        "http://10.0.2.2:8090/realms/DatingApp"
      ]
    }
  }
}
